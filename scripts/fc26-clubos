#!/usr/bin/env bash
APP_HOME="${HOME}/.local/share/fc26-clubos"
source "${APP_HOME}/.venv/bin/activate"
export PYTHONPATH="${APP_HOME}/app:${PYTHONPATH:-}"

python "${APP_HOME}/app/fc26_server.py" >/dev/null 2>&1 &
sleep 1
URL="http://127.0.0.1:43826"
if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "${URL}" >/dev/null 2>&1
else
  echo "${URL}"
fi
